# Managed by Ansible (roles/uptime_kuma). Local edits are overwritten.
#
# The only way into Uptime Kuma from outside its compose network: TLS on
# {{ uptime_kuma_port }}, no plain-HTTP listener at all. A plain HTTP request
# to this port gets nginx's "400 The plain HTTP request was sent to HTTPS
# port" and never reaches Kuma.
#
# Every request, websocket upgrades included, first asks kuma-gate
# (auth_request). The gate answers 204 only while Kuma holds our admin
# account and does not need setup; otherwise 403, so a Kuma that came back on
# an empty database is unreachable instead of handing admin to the first
# visitor. The setup routes are refused outright as well.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen {{ uptime_kuma_port }} ssl;
    server_name _;
    server_tokens off;

    ssl_certificate     /etc/uptime-kuma-tls/cert.pem;
    ssl_certificate_key /etc/uptime-kuma-tls/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 10m;

    # Docker's embedded DNS; names are resolved per request so nginx starts
    # even while Kuma or the gate are still starting (and then refuses).
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $kuma_upstream http://uptime-kuma:3001;
    set $gate_upstream http://kuma-gate:8081/gate;

    location = /__kuma_gate {
        internal;
        proxy_pass $gate_upstream;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 3s;
    }

    # Defence in depth: never serve the setup pages, whatever the gate says.
    location ~ ^/setup(-database)?(/|$) {
        return 403;
    }

    location / {
        auth_request /__kuma_gate;

        proxy_pass $kuma_upstream;
        proxy_http_version 1.1;
        # Kuma's websocket origin check compares Origin with Host, so the
        # browser's Host is passed through unchanged.
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 1h;
    }
}
