# Managed by Ansible (roles/uptime_kuma). Local edits are overwritten.
# One NFS read of {{ uptime_kuma_nfs_probe_server }}:{{ uptime_kuma_nfs_probe_export }}, pushed to Kuma. See /usr/local/bin/kuma-nfs-probe.
[Unit]
Description=Uptime Kuma NFS read probe ({{ uptime_kuma_nfs_probe_server }}:{{ uptime_kuma_nfs_probe_export }})
Documentation=file:/usr/local/bin/kuma-nfs-probe
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/kuma-nfs-probe probe \
    --server {{ uptime_kuma_nfs_probe_server }} \
    --export {{ uptime_kuma_nfs_probe_export }} \
    --sentinel {{ uptime_kuma_nfs_probe_sentinel }} \
    --expected-file /etc/kuma-nfs-probe/sentinel \
    --nfs-version {{ uptime_kuma_nfs_probe_version }} \
    --uid {{ uptime_kuma_nfs_probe_uid }} \
    --gid {{ uptime_kuma_nfs_probe_gid }} \
    --timeout {{ uptime_kuma_nfs_probe_timeout }} \
    --push-base https://127.0.0.1:{{ uptime_kuma_port }}/api/push \
    --push-cafile {{ uptime_kuma_tls_dir }}/cert.pem
# Exit 1 (NFS failed) and 2 (push failed) are results, not unit failures to
# retry; they still show as failed in `systemctl status`.
LoadCredential=push_token:{{ uptime_kuma_secrets_dir }}/nfs_push_token

# No root. The only privilege is binding a source port below 1024, which the
# NAS requires of NFS clients by default ("secure" exports). libnfs tries a
# reserved port first and inherits the capability through the ambient set.
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Outer bound over the script's own deadline. A oneshot stuck in
# "activating" stops its timer from ever firing again.
TimeoutStartSec={{ uptime_kuma_nfs_probe_timeout | int + 40 }}
MemoryMax=128M
TasksMax=16

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
