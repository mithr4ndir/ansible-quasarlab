#!/usr/bin/python3
"""Check that Kuma really holds the monitors this role defines.

Managed by Ansible (roles/uptime_kuma). Local edits are overwritten.

Usage:
    kuma-verify-entities --notification NAME --monitor NAME [--monitor NAME ...]

Writing monitor files is not the same as having monitors: AutoKuma could fail
to log in, reject a file, or create duplicates (AutoKuma#177). So after a
deploy the role asks Kuma itself, through the kuma CLI inside the autokuma
container (which already has the credentials as a file secret), and fails
unless every expected monitor:

  - exists exactly once,
  - is active,
  - has the expected notification enabled.

Prints one JSON line with the findings; exit 0 when all hold, 1 when not,
2 when Kuma could not be asked. Holds and prints no secret: the CLI output is
parsed here and only names and counts are reported.
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from collections import Counter
from typing import Any, Callable, Sequence

CLI_TIMEOUT_SECS = 60


def kuma_cli(args: Sequence[str], docker: str = "docker") -> Any:
    proc = subprocess.run(
        [docker, "exec", "autokuma", "kuma", "--format", "json", *args],
        capture_output=True, text=True, timeout=CLI_TIMEOUT_SECS, check=False,
    )
    if proc.returncode != 0:
        reason = (proc.stderr.strip().splitlines() or [""])[-1][:200]
        raise RuntimeError(f"kuma {' '.join(args)} exited {proc.returncode}: {reason}")
    return json.loads(proc.stdout)


def as_list(value: Any) -> list[dict]:
    """`monitor list` is a map of id to monitor; `notification list` a list."""
    items = value.values() if isinstance(value, dict) else value
    return [item for item in items if isinstance(item, dict)]


def check(monitors: list[dict], notifications: list[dict], expected: Sequence[str],
          notification: str) -> dict:
    counts = Counter(m.get("name") for m in monitors)
    notif_ids = {str(n.get("id")) for n in notifications if n.get("name") == notification}
    by_name = {m.get("name"): m for m in monitors}
    findings: dict[str, Any] = {
        "missing": sorted(n for n in expected if counts[n] == 0),
        "duplicated": sorted(n for n in expected if counts[n] > 1),
        "inactive": sorted(n for n in expected if n in by_name
                           and by_name[n].get("active") in (False, 0)),
        "notification_missing": not notif_ids,
        "not_notifying": [],
    }
    if notif_ids:
        for name in expected:
            wired = (by_name.get(name) or {}).get("notificationIDList") or {}
            if name in by_name and not any(wired.get(i) in (True, 1) for i in notif_ids):
                findings["not_notifying"].append(name)
    findings["ok"] = not any(findings[k] for k in
                             ("missing", "duplicated", "inactive", "notification_missing",
                              "not_notifying"))
    return findings


def main(argv: Sequence[str] | None = None,
         cli: Callable[[Sequence[str]], Any] = kuma_cli) -> int:
    parser = argparse.ArgumentParser(prog="kuma-verify-entities")
    parser.add_argument("--notification", required=True)
    parser.add_argument("--monitor", action="append", required=True)
    args = parser.parse_args(argv)
    try:
        monitors = as_list(cli(["monitor", "list"]))
        notifications = as_list(cli(["notification", "list"]))
    except (RuntimeError, subprocess.TimeoutExpired, OSError, ValueError) as exc:
        print(json.dumps({"ok": False, "error": f"could not ask Kuma: {type(exc).__name__}: {exc}"}))
        return 2
    findings = check(monitors, notifications, args.monitor, args.notification)
    print(json.dumps(findings, sort_keys=True))
    return 0 if findings["ok"] else 1


if __name__ == "__main__":
    sys.exit(main())
