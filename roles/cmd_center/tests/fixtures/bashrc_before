# ~/.bashrc: executed by bash(1) for non-login shells.
# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)
# for examples

# 1Password / Proxmox token for Ansible (must be before non-interactive guard)
if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] && [ -f "$HOME/.config/op/service-account-token" ]; then
    export OP_SERVICE_ACCOUNT_TOKEN="$(cat "$HOME/.config/op/service-account-token")"
fi
if [ -z "${PROXMOX_TOKEN_SECRET:-}" ] && [ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] && command -v op >/dev/null 2>&1; then
    export PROXMOX_TOKEN_SECRET="$(op read "op://Infrastructure/Proxmox API/Ansible Inventory/token_secret" 2>/dev/null || true)"
elif [ -z "${PROXMOX_TOKEN_SECRET:-}" ] && [ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] && [ -x "$HOME/.local/bin/op" ]; then
    export PROXMOX_TOKEN_SECRET="$($HOME/.local/bin/op read "op://Infrastructure/Proxmox API/Ansible Inventory/token_secret" 2>/dev/null || true)"
fi

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

HISTCONTROL=ignoreboth

# Ensure Proxmox token is loaded (after PATH is set)
[[ -z "${PROXMOX_TOKEN_SECRET:-}" ]] && [[ -f /etc/profile.d/op-ansible-env.sh ]] && source /etc/profile.d/op-ansible-env.sh
