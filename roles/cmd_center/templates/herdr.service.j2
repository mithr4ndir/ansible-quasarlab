[Unit]
Description=Herdr headless terminal workspace server
After=network-online.target
Wants=network-online.target

[Service]
# herdr server stays in the foreground, so exec is correct: systemd marks
# the unit active only once the binary has actually been executed.
Type=exec
Environment=TERM=xterm-256color
ExecStart=%h/.local/bin/herdr server
ExecStop=%h/.local/bin/herdr server stop
Restart=on-failure
RestartSec=5
# Agent panes are children of the server. mixed sends SIGTERM to the main
# process only, giving herdr the chance to shut its panes down cleanly
# instead of systemd reaping every pane process at once.
KillMode=mixed
TimeoutStopSec=30

# Every agent pane, and every MCP server a pane starts, is a task in this
# unit's cgroup. On 2026-09-21 the server crossed the inherited
# DefaultTasksMax of 1027 and panicked with
# 'failed to spawn thread: Os { code: 11, kind: WouldBlock }'.
# Stated absolutely, because the 15% default resolves against a thread
# ceiling that Proxmox memory hotplug leaves sized for 1 GiB of RAM.
# LimitNPROC here is close to decoration, and the honest reason took a reboot to
# learn. It is a per-uid rlimit, and a process without CAP_SYS_RESOURCE cannot
# raise one above its own hard limit, so the user manager silently CLAMPS this
# to whatever RLIMIT_NPROC it was started with while `systemctl --user show`
# reports the configured value regardless. The clamp is silent, not fatal.
#
# An earlier version of this comment said DefaultLimitNPROC in
# /etc/systemd/system.conf.d would make it real at the next reboot. It did not.
# command-center1 rebooted 2026-10-02 with that drop-in in place and the user
# manager still came up with a hard limit of 3423, because
# user@<uid>.service runs with PAMName=systemd-user and pam_limits resets the
# limit AFTER systemd has applied it. The value that wins comes from
# /etc/security/limits.d/50-agent-nproc.conf, which this role now manages.
#
# This line stays because it is the correct ceiling to ask for and it costs
# nothing, but it is not what delivers the number.
#
# Check what is enforced with `grep 'Max processes' /proc/$(systemctl --user
# show herdr.service -p MainPID --value)/limits`, never with systemctl show.
TasksMax={{ cmd_center_herdr_tasks_max }}
LimitNPROC={{ cmd_center_herdr_limit_nproc }}

[Install]
WantedBy=default.target
