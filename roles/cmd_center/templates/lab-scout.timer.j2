[Unit]
Description=Weekly lab scout ideas digest to Discord

[Timer]
OnCalendar={{ cmd_center_scout_on_calendar }}
# Catch up after downtime. The lock and the seen state keep a catch-up run
# from posting an idea twice.
Persistent=true
AccuracySec=1min
Unit=lab-scout.service

[Install]
WantedBy=timers.target
