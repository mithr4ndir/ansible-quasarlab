[Unit]
Description=Run Ansible infrastructure playbooks every hour

[Timer]
# Offset by 15 minutes from ansible-security's :00/:30 slots. See the comment
# in ansible-security.timer.j2 for why these are fixed OnCalendar slots
# instead of OnUnitActiveSec.
OnCalendar=*:15
RandomizedDelaySec=2min

[Install]
WantedBy=timers.target
