    ("agent_cmd_audit_withheld_total", "counter", "Commands withheld instead of posted."),
)


def write_metrics(prom_file: Path, values: Mapping[str, float], dropped: Mapping[str, float]) -> None:
    """Atomic textfile-collector write, the herdr-health-collector way.

    The temp file is dot-prefixed so it sits outside node_exporter's *.prom
    glob, the whole file is one write, and the rename is atomic.
    """
    lines: list[str] = []
    for name, kind, help_text in METRIC_HELP:
        lines.append(f"# HELP {name} {help_text}")
        lines.append(f"# TYPE {name} {kind}")
        lines.append(f"{name} {values.get(name, 0):g}")
    lines.append("# HELP agent_cmd_audit_dropped_total Records dropped without reaching Discord.")
    lines.append("# TYPE agent_cmd_audit_dropped_total counter")
    for reason in ("lock", "spool_full", "backlog", "fail_closed", "oversize", "io"):
        lines.append(f'agent_cmd_audit_dropped_total{{reason="{reason}"}} {dropped.get(reason, 0):g}')
    body = "\n".join(lines) + "\n"
    tmp = prom_file.with_name("." + prom_file.name + ".tmp")
    try:
        prom_file.parent.mkdir(parents=True, exist_ok=True)
        tmp.write_text(body, "utf-8")
        os.chmod(tmp, 0o644)
        os.replace(tmp, prom_file)
    except OSError as exc:
        log.warning("metrics: could not be written (%s)", type(exc).__name__)


# ---------------------------------------------------------------------------
# Webhook secret, through the 1Password cache only
# ---------------------------------------------------------------------------

SECRET_SCRIPT = r"""
set -u
lib_dir=$1; slug=$2; ref=$3; token_file=$4
source "$lib_dir/op-killswitch.sh" || exit 3
source "$lib_dir/op-secret-cache.sh" || exit 3
if ! op_secret_cache_is_fresh "$OP_SECRET_CACHE_DIR/$slug"; then
    # A refresh would cost a 1Password read. Load the token FIRST: the quota
    # check fails without one, and the systemd unit exports only HOME and PATH.
    if [[ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" && -r "$token_file" ]]; then
        OP_SERVICE_ACCOUNT_TOKEN=$(<"$token_file")
        export OP_SERVICE_ACCOUNT_TOKEN
    fi
    remaining=$(op_preflight_remaining)
    # Fails CLOSED on an unreadable quota: an audit line is not worth a blind
    # read. Without a token the cache can only serve a stale value.
    if [[ -z "$remaining" ]]; then
        logger -t agent-cmd-audit "1P quota unreadable; not refreshing the webhook cache"
        unset OP_SERVICE_ACCOUNT_TOKEN
    elif (( remaining <= OP_PREFLIGHT_MIN_REMAINING )); then
        logger -t agent-cmd-audit "1P quota at ${remaining}; not refreshing the webhook cache"
        unset OP_SERVICE_ACCOUNT_TOKEN
    fi
fi
cached_op_read "$slug" "$ref"
"""


def webhook_cache_slug(reference: str) -> str | None:
    """Cache slug for this reference, or None when no tag can be derived.

    First 16 hex characters of sha256 over the exact reference string, the
    same scheme lab-changelog uses. Changing the reference changes the slug,
    so a stale cache entry can never post to the previous channel.
    """
    try:
        tag = hashlib.sha256(reference.encode("utf-8")).hexdigest()[:16]
    except (AttributeError, TypeError, ValueError):
        return None
    if not REFERENCE_TAG_RE.match(tag):
        return None
    return f"{WEBHOOK_CACHE_SLUG_PREFIX}.{tag}"


def resolve_webhook(lib_dir: str, reference: str, token_file: str) -> str | None:
    """Return the webhook URL, or None with the reason logged."""
    if not OP_REFERENCE_RE.match(reference or ""):
        log.warning("webhook: configured 1Password reference is malformed; not posting")
        return None
    slug = webhook_cache_slug(reference)
    if slug is None:
        log.warning("webhook: could not derive a cache slug tag; not posting")
        return None
    for lib in ("op-killswitch.sh", "op-secret-cache.sh"):
        if not os.path.isfile(os.path.join(lib_dir, lib)):
            log.warning("webhook: %s missing from the op library directory; not posting", lib)
            return None
    env = dict(os.environ)
    env[CHILD_ENV] = "1"
    try:
        proc = subprocess.run(
            ["bash", "-c", SECRET_SCRIPT, "agent-cmd-audit-secret", lib_dir, slug, reference, token_file],
            capture_output=True,
            text=True,
            timeout=SECRET_TIMEOUT_SECS,
            env=env,
            stdin=subprocess.DEVNULL,
            check=False,
        )
    except subprocess.TimeoutExpired:
        log.warning("webhook: cache lookup timed out; not posting")
        return None
    except OSError as exc:
        log.warning("webhook: cache lookup could not start (%s); not posting", type(exc).__name__)
        return None
    value = proc.stdout.strip()
    register_secret(value)
    if proc.returncode != 0 or not value:
        log.warning(
            "webhook: no value from the 1Password cache (rc=%s; kill switch active, rate limited or not cached); not posting",
            proc.returncode,
        )
        return None
    if not WEBHOOK_RE.match(value):
        log.warning("webhook: cached value is not a Discord webhook URL; not posting")
        return None
    return value


