def herdr_labels(herdr_bin: str, runner: Callable[..., Any] | None = None) -> dict[str, str]:
    """Map workspace id to its human label. Best effort, never fatal."""
    if not herdr_bin:
        return {}
    runner = runner or subprocess.run
    try:
        proc = runner(
            [herdr_bin, "workspace", "list"],
            capture_output=True,
            text=True,
            timeout=HERDR_TIMEOUT_SECS,
            stdin=subprocess.DEVNULL,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return {}
    if getattr(proc, "returncode", 1) != 0:
        return {}
    try:
        payload = json.loads(proc.stdout or "{}")
        workspaces = payload["result"]["workspaces"]
    except (ValueError, KeyError, TypeError):
        return {}
    labels: dict[str, str] = {}
    for workspace in workspaces:
        if isinstance(workspace, dict):
            wid = str(workspace.get("workspace_id") or "")
            label = str(workspace.get("label") or "")
            if wid and label:
                labels[wid] = label
    return labels


def entry_line(record: Mapping[str, Any], cap: int) -> tuple[str, str]:
    """One rendered line, plus the withheld reason if there was one."""
    status = str(record.get("status") or STATUS_OK)
    icon = STATUS_ICON.get(status, "•")
    stamp = str(record.get("ts") or "")[11:19] or "--:--:--"
    command = str(record.get("command") or "")
    safe, reason = sanitize_command(command)
    text = discord_text(safe, cap)
    suffix = ""
    if status == STATUS_FAILED:
        code = record.get("exit_code")
        suffix = f" exit {code}" if isinstance(code, int) else " non-zero"
    elif status == STATUS_BACKGROUNDED:
        suffix = " backgrounded, outcome unknown"
    elif status == STATUS_INTERRUPTED:
        suffix = " interrupted"
    if record.get("canary"):
        return f"`{stamp}` 🐤 canary `{discord_text(str(record.get('nonce') or ''), 40)}`", ""
    return f"`{stamp}` {icon}{suffix} `{text}`", reason


def embed_size(embed: Mapping[str, Any]) -> int:
    total = len(str(embed.get("title", ""))) + len(str(embed.get("description", "")))
    footer = embed.get("footer")
    if isinstance(footer, dict):
        total += len(str(footer.get("text", "")))
    return total


def group_records(records: list[dict[str, Any]]) -> list[tuple[str, list[dict[str, Any]]]]:
    """Group by session, keeping first-seen order."""
    groups: dict[str, list[dict[str, Any]]] = {}
    for record in records:
        groups.setdefault(str(record.get("session_id") or "unknown"), []).append(record)
    return list(groups.items())


def build_embeds(
    records: list[dict[str, Any]], labels: Mapping[str, str], cap: int
) -> tuple[list[dict[str, Any]], int]:
    embeds: list[dict[str, Any]] = []
    withheld = 0
    for session, group in group_records(records)[:EMBEDS_MAX]:
        first = group[0]
        workspace = str(first.get("workspace") or "")
        label = labels.get(workspace, workspace) or "no workspace"
        pane = str(first.get("pane") or "")
        title_bits = [label]
        if pane:
            title_bits.append(pane)
        title_bits.append(str(first.get("agent") or "agent"))
        if first.get("agent_type"):
            title_bits.append(f"subagent {first['agent_type']}")
        lines: list[str] = []
        for record in group:
            line, reason = entry_line(record, cap)
            if reason and reason != "empty":
                withheld += 1
            lines.append(line)
        description = "\n".join(lines)[:EMBED_DESCRIPTION_MAX]
        footer = f"session {session[:8]} · {first.get('host') or '?'}"
        embeds.append({
            "title": discord_text(" · ".join(title_bits), EMBED_TITLE_MAX),
            "description": description,
            "color": EMBED_COLOR,
            "footer": {"text": discord_text(footer, EMBED_FOOTER_MAX)},
        })
    return embeds, withheld


def build_payload(records: list[dict[str, Any]], labels: Mapping[str, str]) -> tuple[dict[str, Any], int]:
    """Shrink the per-entry cap until the batch fits Discord's 6000 total."""
    cap = COMMAND_MAX_CHARS
    embeds, withheld = build_embeds(records, labels, cap)
    while sum(embed_size(e) for e in embeds) > EMBED_TOTAL_MAX and cap > TRIM_FLOOR_CHARS:
        cap = max(int(cap * 0.8), TRIM_FLOOR_CHARS)
        embeds, withheld = build_embeds(records, labels, cap)
    while embeds and sum(embed_size(e) for e in embeds) > EMBED_TOTAL_MAX:
        embeds.pop()
    return {
        "username": "cmd audit",
        "embeds": embeds,
        "allowed_mentions": {"parse": []},
    }, withheld


# ---------------------------------------------------------------------------
# Posting
# ---------------------------------------------------------------------------


def retry_after_secs(error: urllib.error.HTTPError) -> float:
    try:
        body = json.loads(error.read() or b"{}")
        value = float(body.get("retry_after"))
    except (ValueError, TypeError, AttributeError, OSError):
        try:
            value = float(error.headers.get("Retry-After", "1"))
        except (ValueError, TypeError, AttributeError):
            value = 1.0
    return min(max(value, 0.0), POST_MAX_SLEEP_SECS)


def post_payload(
    webhook: str, payload: dict[str, Any], opener: Opener | None = None, sleep: Sleeper = time.sleep
) -> None:
    """POST one message. Raises PostError whose text never holds the URL."""
    opener = opener or urllib.request.urlopen
    data = json.dumps(payload).encode("utf-8")
    delay = 1.0
    for attempt in range(1, POST_MAX_ATTEMPTS + 1):
        request = urllib.request.Request(
            webhook + "?wait=true",
            data=data,
            method="POST",
            headers={"Content-Type": "application/json", "User-Agent": USER_AGENT},
        )
        try:
            # WEBHOOK_RE already pinned the scheme to https.
            with opener(request, timeout=HTTP_TIMEOUT_SECS) as response:  # noqa: S310
                status = getattr(response, "status", 200)
                if 200 <= status < 300:
                    return
                failure = f"HTTP {status}"
                retryable = status >= 500
        except urllib.error.HTTPError as exc:
            status = exc.code
            failure = f"HTTP {status}"
            if status == 429:
                wait = retry_after_secs(exc)
                exc.close()
                if attempt == POST_MAX_ATTEMPTS:
                    break
                log.info("discord rate limited; retrying in %.1fs", wait)
                sleep(wait)
                continue
            exc.close()
            retryable = status >= 500
        except (urllib.error.URLError, OSError, ValueError) as exc:
            # These can carry the URL in their text. Keep only the type.
            failure = type(exc).__name__
            retryable = True
        if not retryable or attempt == POST_MAX_ATTEMPTS:
            raise PostError(f"discord post failed: {failure}") from None
        sleep(min(delay, POST_MAX_SLEEP_SECS))
        delay *= 2
    raise PostError("discord post failed: still rate limited after retries") from None


