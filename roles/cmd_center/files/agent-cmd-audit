# ---------------------------------------------------------------------------
# Logging that can never leak the webhook
# ---------------------------------------------------------------------------

_SECRETS: set[str] = set()
WEBHOOK_ANY_RE = re.compile(r"https?://[^\s\"'<>]*/api/webhooks/[^\s\"'<>]*", re.IGNORECASE)


def register_secret(value: str) -> None:
    if value:
        _SECRETS.add(value)


def redact(text: str) -> str:
    for secret in _SECRETS:
        text = text.replace(secret, "[redacted]")
    return WEBHOOK_ANY_RE.sub("[redacted webhook]", text)


class RedactingFormatter(logging.Formatter):
    """Redacts after formatting, so arguments and tracebacks are covered too."""

    def format(self, record: logging.LogRecord) -> str:
        return redact(super().format(record))


def setup_logging(to_stderr: bool) -> None:
    log.handlers.clear()
    log.setLevel(logging.INFO)
    log.propagate = False
    if not to_stderr:
        log.addHandler(logging.NullHandler())
        return
    fmt = RedactingFormatter("%(asctime)s %(levelname)s %(message)s", "%Y-%m-%dT%H:%M:%SZ")
    fmt.converter = time.gmtime
    handler = logging.StreamHandler(sys.stderr)
    handler.setFormatter(fmt)
    log.addHandler(handler)


def syslog(message: str) -> None:
    """Best effort breadcrumb for the paths that must not write to stdout."""
    try:
        subprocess.run(
            ["logger", "-t", "agent-cmd-audit", redact(message)],
            check=False,
            timeout=5,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.SubprocessError):
        pass


def utcnow() -> dt.datetime:
    return dt.datetime.now(dt.timezone.utc)


def iso(value: dt.datetime) -> str:
    return value.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# ---------------------------------------------------------------------------
# Text that is safe in a Discord embed
# ---------------------------------------------------------------------------

MARKDOWN_CHARS_RE = re.compile(r"([\\\[\]()*_~`|>#<@-])")
URL_SCHEME_RE = re.compile(r"(?i)\b([a-z][a-z0-9+.-]{1,20})://")
MENTION_RE = re.compile(r"@(?=\S)")
WHITESPACE_RE = re.compile(r"\s+")
MENTION_FORMS_RE = re.compile(r"(?i)@everyone|@here|<@[!&]?\d+>")


def clean_text(value: str, limit: int) -> str:
    """Strip control and invisible format characters, collapse whitespace, cap."""
    kept = []
    for char in value:
        category = unicodedata.category(char)
        if category in ("Cc", "Cf", "Cs", "Co", "Cn", "Zl", "Zp"):
            kept.append(" ")
        else:
            kept.append(char)
    text = WHITESPACE_RE.sub(" ", "".join(kept)).strip()
    if len(text) > limit:
        text = text[: max(limit - 1, 0)].rstrip() + "…"
    return text


def discord_text(value: str, limit: int = EMBED_TITLE_MAX) -> str:
    """Make untrusted text inert in a Discord embed.

    Order matters: strip mentions, clean and cap first (so the cap cannot cut
    an escape in half), defang URL schemes so nothing auto-links, then escape
    every markdown character in a single pass.
    """
    text = MENTION_FORMS_RE.sub("", value)
    text = clean_text(text, limit)
    text = URL_SCHEME_RE.sub(r"\1[:]//", text)
    text = MARKDOWN_CHARS_RE.sub(r"\\\1", text)
    return MENTION_RE.sub("@​", text)


# ---------------------------------------------------------------------------
# Redaction of command text
# ---------------------------------------------------------------------------

# The last line of defence, applied AFTER redaction. A command that still
# matches this is withheld rather than posted.
SECRETLIKE_RE = re.compile(
    r"(?i)\b(?:op://|ghp_|gho_|ghs_|ghu_|github_pat_|sk-ant-|xox[abprs]-|glpat-"
    r"|dckr_pat_|AKIA[0-9A-Z]{16}|password\s*[:=]|token\s*[:=]|secret\s*[:=])"
)

# Value-only substitutions: the key survives so the reader knows what was
# hidden, the value never does.
SECRET_NAME = r"(?:password|passwd|pass|token|secret|api[-_]?key|apikey|bearer|auth[a-z_]*|credential[s]?)"
CMD_REDACTIONS: tuple[tuple[re.Pattern[str], str], ...] = (
    # Known token shapes, wherever they appear.
    (re.compile(r"\b(?:ghp|gho|ghs|ghu)_[A-Za-z0-9]{16,}"), "[redacted token]"),
    (re.compile(r"\bgithub_pat_[A-Za-z0-9_]{16,}"), "[redacted token]"),
    (re.compile(r"\bsk-ant-[A-Za-z0-9_-]{16,}"), "[redacted token]"),
    (re.compile(r"\bsk-[A-Za-z0-9]{20,}"), "[redacted token]"),
    (re.compile(r"\bxox[abprs]-[A-Za-z0-9-]{10,}"), "[redacted token]"),
    (re.compile(r"\bglpat-[A-Za-z0-9_-]{16,}"), "[redacted token]"),
    (re.compile(r"\bdckr_pat_[A-Za-z0-9_-]{16,}"), "[redacted token]"),
    (re.compile(r"\bAKIA[0-9A-Z]{16}\b"), "[redacted key id]"),
    (re.compile(r"\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.?[A-Za-z0-9_-]*"), "[redacted jwt]"),
    # op:// leaks vault and item topology even though it is not itself a secret.
    (re.compile(r"\bop://[A-Za-z0-9 _./-]+"), "op://[redacted]"),
    # Assignment and flag forms.
    (re.compile(r"(?i)\b(" + SECRET_NAME + r")(\s*[:=]\s*)(\S+)"), r"\1\2[redacted]"),
    (re.compile(r"(?i)(--(?:" + SECRET_NAME + r")[a-z-]*)([= ])(\S+)"), r"\1\2[redacted]"),
    (re.compile(r"(?i)(--from-literal=[A-Za-z0-9_.-]+=)(\S+)"), r"\1[redacted]"),
    (re.compile(r"(?i)(Authorization:\s*(?:Bearer|Basic)\s+)(\S+)"), r"\1[redacted]"),
    (re.compile(r"(-u\s+)(\S+:\S+)"), r"\1[redacted]"),
)
# There is deliberately no rule for a bare `-p<value>`. It cannot be told
# apart from ordinary long options (it ate `git status --porcelain` in
# testing), and the programs that actually take a password that way (mysql,
# psql) are in SENSITIVE_PROGRAMS, so their arguments are withheld wholesale.

# A heredoc introducer, with its delimiter. The lookbehind and lookahead keep
# `<<<` (a herestring, which is one line and redacts like any other command)
# from being read as a heredoc whose delimiter happens to start with `<`.
HEREDOC_INTRO_RE = re.compile(
    r"(?<!<)<<(?P<dash>-?)\s*(?P<quote>['\"]?)(?P<word>\\?[A-Za-z_][A-Za-z0-9_]*)(?P=quote)"
)
PRIVATE_KEY_RE = re.compile(r"-----BEGIN[A-Z ]*PRIVATE KEY")
# Programs whose arguments are not worth the risk. The audit fact that an
# agent ran `op` is what matters; the arguments are not.
SENSITIVE_PROGRAMS = frozenset({
    "op", "pass", "gpg", "gpg2", "age", "sops", "vault", "ansible-vault",
    "keyctl", "openssl", "htpasswd", "passwd", "chpasswd", "mysql", "psql",
})
SENSITIVE_PHRASES = ("docker login", "kubectl create secret", "gh auth", "az login", "aws configure")

WITHHELD_SECRET = "«withheld: matched a secret pattern»"
WITHHELD_HEREDOC = "«heredoc body withheld»"
WITHHELD_ARGS = "«args withheld»"
WITHHELD_OVERSIZE = "«oversize command withheld»"
WITHHELD_KEY = "«private key material withheld»"


# A leading VAR=value assignment, which is not the program. Anchored on the
# NAME= form: testing for a bare "=" read `E=/tmp/scratch/e2e2;` as the
# program `e2e2;`, because the "=" is not in the last path segment.
ASSIGNMENT_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")


def program_name(command: str) -> str:
    """First bare word of the command, for the withheld forms."""
    for token in command.strip().split():
        if ASSIGNMENT_RE.match(token):
            continue  # leading VAR=value assignments
        return os.path.basename(token)[:40]
    return "?"


def strip_heredoc_bodies(command: str) -> tuple[str, bool]:
    """Replace every heredoc body with a placeholder, keeping the lines around it.

    The introducer line and the terminator survive, so a reader still sees the
    program, its flags and where the output went; only the free-form body is
    dropped, because the value-only redactions are shape-based and cannot scan
    a pasted blob. An unterminated heredoc swallows the rest of the command,
    so body text can never be mistaken for command text.
    """
    lines = command.split("\n")
    out: list[str] = []
    index = 0
    found = False
    while index < len(lines):
        line = lines[index]
        index += 1
        out.append(line)
        intros = [
            (bool(match.group("dash")), match.group("word").lstrip("\\"))
            for match in HEREDOC_INTRO_RE.finditer(line)
        ]
        if not intros:
            continue
        found = True
        for dashed, delimiter in intros:
            body_seen = False
            terminated = False
            while index < len(lines):
                candidate = lines[index]
                index += 1
                # <<- strips leading TABS from the terminator, nothing else.
                probe = candidate.lstrip("\t") if dashed else candidate
                if probe.rstrip("\r") == delimiter:
                    terminated = True
                    break
                body_seen = True
            if body_seen or not terminated:
                out.append(WITHHELD_HEREDOC)
            if not terminated:
                break
            out.append(delimiter)
    return "\n".join(out), found


def sanitize_command(command: str) -> tuple[str, str]:
    """Return (text safe to post, reason it was withheld or "").

    Fails closed: anything still matching SECRETLIKE_RE after redaction is
    withheld rather than posted.
    """
    if not command.strip():
        return "", "empty"
    program = program_name(command)
    # Bodies go first, so the size and secret checks below judge the text that
    # would actually be posted rather than a blob that is already dropped.
    command, had_heredoc = strip_heredoc_bodies(command)
    if len(command) > HARD_DROP_CHARS:
        return f"{program} {WITHHELD_OVERSIZE}", "oversize"
    if PRIVATE_KEY_RE.search(command):
        return f"{program} {WITHHELD_KEY}", "private_key"
    lowered = command.lower()
    if program in SENSITIVE_PROGRAMS or any(p in lowered for p in SENSITIVE_PHRASES):
        return f"{program} {WITHHELD_ARGS}", "sensitive_program"

    text = redact(command)
    for pattern, replacement in CMD_REDACTIONS:
        text = pattern.sub(replacement, text)
    if SECRETLIKE_RE.search(text):
        return f"{program} {WITHHELD_SECRET}", "fail_closed"
    return text, "heredoc" if had_heredoc else ""


