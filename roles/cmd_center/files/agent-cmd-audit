CONFIG_KEYS = frozenset({
    "AGENT_CMD_AUDIT_ENABLED",
    "AGENT_CMD_AUDIT_OP_REFERENCE",
    "AGENT_CMD_AUDIT_OP_LIB_DIR",
    "AGENT_CMD_AUDIT_OP_TOKEN_FILE",
    "AGENT_CMD_AUDIT_STATE_DIR",
    "AGENT_CMD_AUDIT_PROM_FILE",
    "AGENT_CMD_AUDIT_HOST",
    "AGENT_CMD_AUDIT_HERDR_BIN",
})

DEFAULT_CONFIG_PATH = "/etc/default/agent-cmd-audit"
DEFAULT_STATE_DIR = "~/.local/state/agent-cmd-audit"
DEFAULT_PROM_FILE = "/var/lib/node_exporter/textfiles/agent_cmd_audit.prom"


def load_config_file(path: str) -> dict[str, str]:
    """KEY=VALUE lines. Only AGENT_CMD_AUDIT_* settings are honoured."""
    values: dict[str, str] = {}
    if not path:
        return values
    try:
        text = Path(path).read_text("utf-8")
    except OSError:
        return values
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        key = key.strip()
        if key in CONFIG_KEYS:
            values[key] = value.strip().strip('"').strip("'")
    return values


class Config:
    def __init__(self, env: Mapping[str, str] | None = None) -> None:
        env = dict(os.environ if env is None else env)
        merged = load_config_file(env.get("AGENT_CMD_AUDIT_CONFIG", DEFAULT_CONFIG_PATH))
        merged.update({k: v for k, v in env.items() if k in CONFIG_KEYS})
        self.enabled = merged.get("AGENT_CMD_AUDIT_ENABLED", "1").strip() not in ("0", "false", "no")
        self.reference = merged.get("AGENT_CMD_AUDIT_OP_REFERENCE", "")
        self.lib_dir = merged.get("AGENT_CMD_AUDIT_OP_LIB_DIR", "")
        self.token_file = merged.get("AGENT_CMD_AUDIT_OP_TOKEN_FILE", "")
        self.state_dir = Path(os.path.expanduser(merged.get("AGENT_CMD_AUDIT_STATE_DIR", DEFAULT_STATE_DIR)))
        self.prom_file = Path(merged.get("AGENT_CMD_AUDIT_PROM_FILE", DEFAULT_PROM_FILE))
        self.host = merged.get("AGENT_CMD_AUDIT_HOST", "") or os.uname().nodename
        self.herdr_bin = merged.get("AGENT_CMD_AUDIT_HERDR_BIN", "")

    @property
    def off_file(self) -> Path:
        return self.state_dir / "OFF"

    def recording_enabled(self) -> bool:
        """Config switch and the runtime OFF file, which needs no deploy."""
        return self.enabled and not self.off_file.exists()


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------


def bump(state: dict[str, Any], key: str, amount: float = 1) -> None:
    state[key] = float(state.get(key, 0)) + amount


def bump_drop(state: dict[str, Any], reason: str) -> None:
    dropped = state.setdefault("dropped", {})
    if isinstance(dropped, dict):
        dropped[reason] = float(dropped.get(reason, 0)) + 1


def cmd_record(args: argparse.Namespace, cfg: Config) -> int:
    """Hook entry point. Never fails, never writes to stdout."""
    if not cfg.recording_enabled():
        return 0
    raw = read_stdin_limited()
    if not raw:
        return 0
    try:
        payload = json.loads(raw)
    except ValueError:
        syslog("record: hook payload was not JSON")
        return 0
    if not isinstance(payload, dict):
        return 0
    if str(payload.get("tool_name") or "") != "Bash":
        return 0
    record = build_record(payload, os.environ, utcnow())
    if not record["command"].strip():
        return 0
    reason = append_record(cfg.state_dir, record)
    if reason:
        # Counting happens in the flusher, which owns state.json; a dropped
        # record leaves a breadcrumb so the reason is never invisible.
        syslog(f"record: dropped ({reason})")
    return 0


def cmd_canary(args: argparse.Namespace, cfg: Config) -> int:
    """Spool a synthetic record through the same path the hook uses."""
    if not cfg.recording_enabled():
        return 0
    nonce = hashlib.sha256(os.urandom(16)).hexdigest()[:12]
    record = {
        "ts": iso(utcnow()),
        "event": "Canary",
        "status": STATUS_OK,
        "command": "",
        "canary": True,
        "nonce": nonce,
        "session_id": "canary",
        "workspace": "",
        "pane": "",
        "host": cfg.host,
        "agent": "canary",
    }
    reason = append_record(cfg.state_dir, record, wait=FLUSH_LOCK_WAIT_SECS)
    if reason:
        syslog(f"canary: dropped ({reason})")
        return 0
    return 0


def flush_once(
    cfg: Config,
    dry_run: bool,
    opener: Opener | None = None,
    sleep: Sleeper = time.sleep,
    runner: Callable[..., Any] | None = None,
) -> dict[str, Any]:
    """One flush pass. Returns the state it wrote, for tests."""
    state = load_state(cfg.state_dir)
    state["last_run"] = time.time()
    dropped_backlog = 0

    try:
        seal_spool(cfg.state_dir)
    except AuditError:
        log.warning("spool: could not be sealed; another run holds the lock")
    except OSError as exc:
        log.warning("spool: could not be sealed (%s)", type(exc).__name__)

    dropped_backlog = trim_inbox(cfg.state_dir)
    if dropped_backlog:
        for _ in range(dropped_backlog):
            bump_drop(state, "backlog")
        log.warning("inbox: dropped %d record(s) over the backlog cap", dropped_backlog)

    batches = inbox_batches(cfg.state_dir)
    if not batches:
        finish_metrics(cfg, state)
        save_state(cfg.state_dir, state)
        return state

    webhook: str | None = None
    if not dry_run:
        last = float(state.get("last_secret_lookup", 0) or 0)
        if time.time() - last < MIN_SECRET_LOOKUP_INTERVAL_SECS and not state.get("webhook_ok"):
            log.info("webhook: lookup floor not reached; leaving the batch for the next run")
            finish_metrics(cfg, state)
            save_state(cfg.state_dir, state)
            return state
        state["last_secret_lookup"] = time.time()
        webhook = resolve_webhook(cfg.lib_dir, cfg.reference, cfg.token_file)
        state["webhook_ok"] = bool(webhook)
        if webhook is None:
            bump(state, "no_webhook_total")
            finish_metrics(cfg, state)
            save_state(cfg.state_dir, state)
            return state

    labels = herdr_labels(cfg.herdr_bin, runner)
    messages = 0
    for batch in batches:
        if messages >= MAX_MESSAGES_PER_FLUSH:
            break
        records, bad = read_batch(batch)
        if bad:
            bump(state, "unparseable_total", bad)
        if not records:
            batch.unlink(missing_ok=True)
            continue
        posted, remainder = records[:MAX_RECORDS_PER_FLUSH], records[MAX_RECORDS_PER_FLUSH:]
        payload, withheld = build_payload(posted, labels)
        if not payload["embeds"]:
            batch.unlink(missing_ok=True)
            continue
        if dry_run:
            print(json.dumps(payload, indent=2, ensure_ascii=False))
            messages += 1
            continue
        if messages:
            sleep(INTER_MESSAGE_SLEEP_SECS)
        try:
            assert webhook is not None
            post_payload(webhook, payload, opener=opener, sleep=sleep)
        except PostError as exc:
            # Leave the batch for the next tick and exit 0: a Discord outage
            # must not become a unit-failure alert.
            log.warning("%s", exc)
            bump(state, "post_failures_total")
            break
        messages += 1
        bump(state, "posted_total", len(posted))
        bump(state, "withheld_total", withheld)
        state["last_success"] = time.time()
        if any(r.get("canary") for r in posted):
            state["canary_posted"] = time.time()
        write_remainder(batch, remainder)
        batch.unlink(missing_ok=True)

    finish_metrics(cfg, state)
    save_state(cfg.state_dir, state)
    return state


def finish_metrics(cfg: Config, state: Mapping[str, Any]) -> None:
    batches = inbox_batches(cfg.state_dir)
    inbox_bytes = sum(p.stat().st_size for p in batches if p.exists())
    try:
        spool_bytes = (cfg.state_dir / "current.jsonl").stat().st_size
    except OSError:
        spool_bytes = 0
    dropped = state.get("dropped")
    dropped = dropped if isinstance(dropped, dict) else {}
    write_metrics(
        cfg.prom_file,
        {
            "agent_cmd_audit_enabled": 1 if cfg.recording_enabled() else 0,
            "agent_cmd_audit_last_run_timestamp_seconds": float(state.get("last_run", 0) or 0),
            "agent_cmd_audit_last_success_timestamp_seconds": float(state.get("last_success", 0) or 0),
            "agent_cmd_audit_canary_posted_timestamp_seconds": float(state.get("canary_posted", 0) or 0),
            "agent_cmd_audit_inbox_files": len(batches),
            "agent_cmd_audit_inbox_bytes": inbox_bytes,
            "agent_cmd_audit_spool_bytes": spool_bytes,
            "agent_cmd_audit_posted_total": float(state.get("posted_total", 0) or 0),
            "agent_cmd_audit_post_failures_total": float(state.get("post_failures_total", 0) or 0),
            "agent_cmd_audit_no_webhook_total": float(state.get("no_webhook_total", 0) or 0),
            "agent_cmd_audit_unparseable_total": float(state.get("unparseable_total", 0) or 0),
            "agent_cmd_audit_withheld_total": float(state.get("withheld_total", 0) or 0),
        },
        dropped,
    )


def cmd_flush(args: argparse.Namespace, cfg: Config) -> int:
    flush_once(cfg, dry_run=bool(args.dry_run))
    return 0


class QuietParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:  # type: ignore[override]
        raise AuditError(f"usage: {message}")


def build_parser() -> argparse.ArgumentParser:
    parser = QuietParser(prog="agent-cmd-audit", add_help=True)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("record", help="Claude Code PostToolUse hook")
    sub.add_parser("canary", help="spool a synthetic record")
    flush = sub.add_parser("flush", help="post spooled records")
    flush.add_argument("--dry-run", action="store_true", help="print the payload, post nothing")
    return parser


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    quiet = bool(argv) and argv[0] in ("record", "canary")
    setup_logging(to_stderr=not quiet)
    try:
        args = build_parser().parse_args(argv)
        cfg = Config()
        if args.command == "record":
            return cmd_record(args, cfg)
        if args.command == "canary":
            return cmd_canary(args, cfg)
        return cmd_flush(args, cfg)
    except AuditError as exc:
        if quiet:
            syslog(str(exc))
            return 0
        log.error("%s", exc)
        return 1
    except Exception as exc:  # noqa: BLE001 - the hook must never break a session
        if quiet:
            syslog(f"unexpected failure: {type(exc).__name__}")
            return 0
        raise


if __name__ == "__main__":
    sys.exit(main())
