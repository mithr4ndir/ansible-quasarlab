def read_stdin_limited(stream: Any = None) -> bytes:
    """Read hook JSON without ever hanging an agent on an open stdin."""
    stream = stream if stream is not None else sys.stdin.buffer
    chunks: list[bytes] = []
    total = 0
    deadline = time.monotonic() + HOOK_STDIN_WAIT_SECS
    try:
        fd = stream.fileno()
    except (AttributeError, OSError, ValueError):
        return stream.read(HOOK_STDIN_MAX_BYTES) if hasattr(stream, "read") else b""
    while total < HOOK_STDIN_MAX_BYTES:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        try:
            ready, _, _ = select.select([fd], [], [], remaining)
        except (OSError, ValueError):
            break
        if not ready:
            break
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        chunks.append(chunk)
        total += len(chunk)
    return b"".join(chunks)[:HOOK_STDIN_MAX_BYTES]


EXIT_CODE_RE = re.compile(r"exit code[:\s]+(\d{1,3})", re.IGNORECASE)


def parse_exit_code(error: str) -> int | None:
    """Pull the exit code out of a PostToolUseFailure error string.

    Verified against Claude Code 2.1.273: a failing Bash call records
    "Error: Exit code 3". There is no exit_code field on the Bash tool result,
    so this string is the only place the number appears. Tolerant on purpose:
    an upgrade that rewords it degrades to "non-zero, code unknown" rather
    than mislabelling the entry.
    """
    match = EXIT_CODE_RE.search(error or "")
    if not match:
        return None
    try:
        return int(match.group(1))
    except ValueError:
        return None


def build_record(payload: Mapping[str, Any], env: Mapping[str, str], now: dt.datetime) -> dict[str, Any]:
    """One spool record from a PostToolUse or PostToolUseFailure payload."""
    tool_input = payload.get("tool_input")
    tool_input = tool_input if isinstance(tool_input, dict) else {}
    response = payload.get("tool_response")
    response = response if isinstance(response, dict) else {}
    event = str(payload.get("hook_event_name") or "")
    error = payload.get("error")
    error = error if isinstance(error, str) else ""

    backgrounded = bool(tool_input.get("run_in_background")) or bool(response.get("backgroundTaskId"))
    if event == "PostToolUseFailure":
        status = STATUS_INTERRUPTED if payload.get("is_interrupt") else STATUS_FAILED
    elif backgrounded:
        status = STATUS_BACKGROUNDED
    elif response.get("interrupted"):
        status = STATUS_INTERRUPTED
    else:
        status = STATUS_OK

    command = tool_input.get("command")
    command = command if isinstance(command, str) else ""
    record: dict[str, Any] = {
        "ts": iso(now),
        "event": event,
        "status": status,
        "command": command[:HARD_DROP_CHARS],
        "session_id": str(payload.get("session_id") or ""),
        "cwd": str(payload.get("cwd") or ""),
        "workspace": env.get("HERDR_WORKSPACE_ID", ""),
        "pane": env.get("HERDR_PANE_ID", ""),
        "host": env.get("AGENT_CMD_AUDIT_HOST", "") or os.uname().nodename,
        "agent": "claude",
    }
    if payload.get("agent_id"):
        record["agent_id"] = str(payload["agent_id"])
    if payload.get("agent_type"):
        record["agent_type"] = str(payload["agent_type"])
    if isinstance(payload.get("duration_ms"), (int, float)):
        record["duration_ms"] = int(payload["duration_ms"])
    if status == STATUS_FAILED:
        code = parse_exit_code(error)
        if code is not None:
            record["exit_code"] = code
    return record


# ---------------------------------------------------------------------------
# Spool
# ---------------------------------------------------------------------------


class SpoolLock:
    """flock on a file that is never renamed, so rotation stays atomic."""

    def __init__(self, state_dir: Path, wait: float) -> None:
        self.path = state_dir / ".lock"
        self.wait = wait
        self.fd: int | None = None

    def __enter__(self) -> "SpoolLock":
        self.path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        self.fd = os.open(self.path, os.O_RDWR | os.O_CREAT, 0o600)
        deadline = time.monotonic() + self.wait
        while True:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    os.close(self.fd)
                    self.fd = None
                    raise AuditError("another agent-cmd-audit run holds the lock") from None
                time.sleep(0.02)

    def __exit__(self, *exc: object) -> None:
        if self.fd is not None:
            fcntl.flock(self.fd, fcntl.LOCK_UN)
            os.close(self.fd)
            self.fd = None


def append_record(state_dir: Path, record: Mapping[str, Any], wait: float = RECORD_LOCK_WAIT_SECS) -> str:
    """Append one record. Returns "" on success or a drop reason.

    The fd is opened inside the lock, so no writer can hold one across the
    flusher's rename and a sealed batch can never be appended to.
    """
    line = json.dumps(record, separators=(",", ":"), ensure_ascii=False)
    if len(line.encode("utf-8")) > RECORD_MAX_BYTES:
        trimmed = dict(record)
        keep = max(RECORD_MAX_BYTES // 2, 256)
        trimmed["command"] = str(record.get("command", ""))[:keep]
        trimmed["truncated_at_record"] = True
        line = json.dumps(trimmed, separators=(",", ":"), ensure_ascii=False)
    data = (line + "\n").encode("utf-8")[:RECORD_MAX_BYTES]
    if not data.endswith(b"\n"):
        data += b"\n"

    current = state_dir / "current.jsonl"
    try:
        with SpoolLock(state_dir, wait):
            try:
                if current.stat().st_size + len(data) > MAX_CURRENT_BYTES:
                    return "spool_full"
            except FileNotFoundError:
                pass
            fd = os.open(current, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
            try:
                os.write(fd, data)
            finally:
                os.close(fd)
    except AuditError:
        return "lock"
    except OSError:
        return "io"
    return ""


def seal_spool(state_dir: Path) -> Path | None:
    """Rename the active spool into the inbox. The rename is the ledger."""
    current = state_dir / "current.jsonl"
    inbox = state_dir / "inbox"
    with SpoolLock(state_dir, FLUSH_LOCK_WAIT_SECS):
        if not current.exists() or current.stat().st_size == 0:
            return None
        inbox.mkdir(mode=0o700, parents=True, exist_ok=True)
        sealed = inbox / f"{time.time_ns()}.jsonl"
        os.rename(current, sealed)
        return sealed


def inbox_batches(state_dir: Path) -> list[Path]:
    inbox = state_dir / "inbox"
    if not inbox.is_dir():
        return []
    return sorted((p for p in inbox.iterdir() if p.name.endswith(".jsonl")), key=lambda p: p.name)


def trim_inbox(state_dir: Path) -> int:
    """Drop the OLDEST batches over the caps, so the feed stays live."""
    batches = inbox_batches(state_dir)
    dropped = 0
    total = sum(p.stat().st_size for p in batches if p.exists())
    while batches and (len(batches) > MAX_INBOX_FILES or total > MAX_INBOX_BYTES):
        victim = batches.pop(0)
        try:
            size = victim.stat().st_size
            with victim.open("rb") as handle:
                dropped += sum(1 for _ in handle)
            victim.unlink()
            total -= size
        except OSError:
            break
    return dropped


def read_batch(path: Path) -> tuple[list[dict[str, Any]], int]:
    """Parse a sealed batch. Returns (records, unparseable count)."""
    records: list[dict[str, Any]] = []
    bad = 0
    try:
        text = path.read_text("utf-8", errors="replace")
    except OSError:
        return [], 0
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            value = json.loads(line)
        except ValueError:
            bad += 1
            continue
        if isinstance(value, dict):
            records.append(value)
        else:
            bad += 1
    return records, bad


def write_remainder(path: Path, records: list[dict[str, Any]]) -> None:
    """Carry unposted records to the next tick, preserving order."""
    if not records:
        return
    part = path.with_suffix(".part.jsonl")
    body = "".join(json.dumps(r, separators=(",", ":"), ensure_ascii=False) + "\n" for r in records)
    tmp = part.with_name("." + part.name + ".tmp")
    tmp.write_text(body, "utf-8")
    os.chmod(tmp, 0o600)
    os.replace(tmp, part)


