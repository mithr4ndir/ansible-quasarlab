# ---------------------------------------------------------------------------
# Logging that can never leak the webhook
# ---------------------------------------------------------------------------

_SECRETS: set[str] = set()
WEBHOOK_ANY_RE = re.compile(r"https?://[^\s\"'<>]*/api/webhooks/[^\s\"'<>]*", re.IGNORECASE)


def register_secret(value: str) -> None:
    if value:
        _SECRETS.add(value)


def redact(text: str) -> str:
    for secret in _SECRETS:
        text = text.replace(secret, "[redacted]")
    return WEBHOOK_ANY_RE.sub("[redacted webhook]", text)


class RedactingFormatter(logging.Formatter):
    """Redacts after formatting, so arguments and tracebacks are covered too."""

    def format(self, record: logging.LogRecord) -> str:
        return redact(super().format(record))


def setup_logging(state_dir: Path, to_stderr: bool) -> None:
    log.handlers.clear()
    log.setLevel(logging.INFO)
    log.propagate = False
    fmt = RedactingFormatter("%(asctime)s %(levelname)s %(message)s", "%Y-%m-%dT%H:%M:%SZ")
    fmt.converter = time.gmtime
    try:
        state_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
        handler: logging.Handler = logging.FileHandler(state_dir / "lab-changelog.log")
        handler.setFormatter(fmt)
        log.addHandler(handler)
    except OSError:
        pass
    if to_stderr:
        err = logging.StreamHandler(sys.stderr)
        err.setFormatter(fmt)
        log.addHandler(err)
    if not log.handlers:
        log.addHandler(logging.NullHandler())


# ---------------------------------------------------------------------------
# Time helpers
