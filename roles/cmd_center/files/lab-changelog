@dataclass(frozen=True)
class Item:
    kind: str
    repo: str
    number: int
    title: str
    body: str
    # When the event happened (ISO 8601). Part of the dedup key only for
    # closures: an issue can be reopened and closed again, and each closure is
    # its own event, while an overlapping re-scan of one closure is not.
    occurred: str = ""

    @property
    def key(self) -> str:
        base = f"{self.repo}#{self.number}:{self.kind}"
        if self.kind == "issue_closed" and self.occurred:
            return f"{base}@{self.occurred}"
        return base

    @property
    def url(self) -> str:
        # Built from validated parts, never taken from the API response.
        section = "pull" if self.kind == "pr_merged" else "issues"
        return f"https://github.com/{self.repo}/{section}/{self.number}"


Runner = Callable[[list[str], int], str]


def run_gh(argv: list[str], timeout: int) -> str:
    env = dict(os.environ)
    env[CHILD_ENV] = "1"
    env["GH_PROMPT_DISABLED"] = "1"
    env["NO_COLOR"] = "1"
    proc = subprocess.run(
        argv,
        capture_output=True,
        text=True,
        timeout=timeout,
        env=env,
        stdin=subprocess.DEVNULL,
        check=False,
    )
    if proc.returncode != 0:
        lines = proc.stderr.strip().splitlines()
        detail = clean_text(lines[-1], 200) if lines else "no stderr"
        raise ChangelogError(f"gh exited {proc.returncode}: {detail}")
    return proc.stdout


QUERIES = {
    # kind: (gh subcommand, --state, search qualifier, timestamp field)
    "pr_merged": ("pr", "merged", "merged", "mergedAt"),
    "issue_opened": ("issue", "all", "created", "createdAt"),
    "issue_closed": ("issue", "closed", "closed", "closedAt"),
}


def gh_argv(kind: str, repo: str, start: dt.datetime, until: dt.datetime | None = None) -> list[str]:
    noun, state, qualifier, stamp_field = QUERIES[kind]
    span = f">={iso(start)}" if until is None else f"{iso(start)}..{iso(until)}"
    return [
        "gh", noun, "list",
        "--repo", repo,
        "--state", state,
        "--search", f"{qualifier}:{span}",
        "--limit", str(GH_LIMIT),
        "--json", f"number,title,url,body,{stamp_field}",
    ]


class TruncatedResult(ChangelogError):
    """A query still hit the --limit cap after splitting its window."""


def fetch_rows(kind: str, repo: str, start: dt.datetime, end: dt.datetime, runner: Runner) -> list[Any]:
    """Every row in [start, end] for one repo and kind.

    gh returns at most GH_LIMIT rows and says nothing when it stops there, and
    GitHub search does not order by merge or close time, so "page from the
    oldest row seen" can skip rows. A result that reaches the cap is treated
    as possibly incomplete: its window is split in half (whole seconds,
    inclusive ranges) and each half is queried again. A one second window that
    still hits the cap, or a runaway number of queries, raises instead of
    returning a silently partial list.
    """
    budget = [GH_MAX_QUERIES]
    by_number: dict[Any, Any] = {}

    def query(lo: dt.datetime, hi: dt.datetime | None) -> None:
        if budget[0] <= 0:
            raise TruncatedResult(f"more than {GH_MAX_QUERIES} queries needed; result would be partial")
        budget[0] -= 1
        rows = json.loads(runner(gh_argv(kind, repo, lo, hi), GH_TIMEOUT_SECS) or "[]")
        if not isinstance(rows, list):
            raise ChangelogError("gh returned something other than a list")
        if len(rows) < GH_LIMIT:
            for row in rows:
                key = row.get("number") if isinstance(row, dict) else None
                by_number[key if key is not None else ("row", len(by_number))] = row
            return
        top = end if hi is None or hi > end else hi
        if top - lo < dt.timedelta(seconds=1):
            raise TruncatedResult(f"{GH_LIMIT} or more results within one second at {iso(lo)}")
        mid = lo + (top - lo) / 2
        mid = mid.replace(microsecond=0)
        log.info("gh result hit the %d row cap: repo=%s kind=%s; splitting %s..%s",
                 GH_LIMIT, repo, kind, iso(lo), iso(top))
        query(lo, mid)
        query(mid + dt.timedelta(seconds=1), top)

    query(start.replace(microsecond=0), None)
    return list(by_number.values())


def collect(
    repos: Iterable[str],
    start: dt.datetime,
    end: dt.datetime,
    runner: Runner | None = None,
    failed: list[str] | None = None,
) -> list[Item]:
    """Items in the window. Failed queries are logged and, when `failed` is
    given, recorded there, so a caller can tell a partial collection apart."""
    runner = runner or run_gh
    items: list[Item] = []
    failures = 0
    repos = list(repos)
    for repo in repos:
        for kind in KINDS:
            stamp_field = QUERIES[kind][3]
            try:
                rows = fetch_rows(kind, repo, start, end, runner)
            except ChangelogError as exc:
                failures += 1
                log.warning("gh query failed: repo=%s kind=%s: %s", repo, kind, exc)
                if failed is not None:
                    failed.append(f"{repo}:{kind}")
                continue
            except (ValueError, OSError, subprocess.TimeoutExpired) as exc:
                failures += 1
                log.warning("gh query failed: repo=%s kind=%s: %s", repo, kind, type(exc).__name__)
                if failed is not None:
                    failed.append(f"{repo}:{kind}")
                continue
            if not isinstance(rows, list):
                failures += 1
                if failed is not None:
                    failed.append(f"{repo}:{kind}")
                continue
            for row in rows:
                item = item_from_row(kind, repo, row, stamp_field, start, end)
                if item is not None:
                    items.append(item)
    if repos and failures == len(repos) * len(KINDS):
        raise ChangelogError("every gh query failed")
    items.sort(key=lambda it: (KINDS.index(it.kind), it.repo, it.number))
    return items


def item_from_row(kind: str, repo: str, row: Any, stamp_field: str, start: dt.datetime, end: dt.datetime) -> Item | None:
    if not isinstance(row, dict):
        return None
    number = row.get("number")
    if not isinstance(number, int) or isinstance(number, bool) or number <= 0:
        return None
    url = row.get("url")
    # `gh issue list` should only return issues. Drop anything else.
    if kind != "pr_merged" and isinstance(url, str) and "/pull/" in url:
        return None
    stamp = parse_ts(row.get(stamp_field))
    # Search qualifiers are coarse; the timestamp decides.
    if stamp is None or stamp < start or stamp > end:
        return None
    title = row.get("title")
    body = row.get("body")
    return Item(
        kind=kind,
        repo=repo,
        number=number,
        title=title if isinstance(title, str) else "",
        body=body if isinstance(body, str) else "",
        occurred=iso(stamp),
    )


# ---------------------------------------------------------------------------
# Untrusted text to Discord text
# ---------------------------------------------------------------------------

# Every character with meaning in Discord markdown. Escaped in ONE pass, so a
# backslash in the input can never cancel an escape we add. (Escaping [ and ]
# first and then running a general escaper that also escapes backslashes
# would turn "\[" into "\\[" and hand the brackets their meaning back.)
MARKDOWN_CHARS_RE = re.compile(r"([\\\[\]()*_~`|>#<@-])")
URL_SCHEME_RE = re.compile(r"(?i)\b([a-z][a-z0-9+.-]{1,20})://")
MENTION_RE = re.compile(r"@(?=\S)")
WHITESPACE_RE = re.compile(r"\s+")


def clean_text(value: str, limit: int) -> str:
    """Strip control and invisible format characters, collapse whitespace, cap."""
    kept = []
    for char in value:
        category = unicodedata.category(char)
        if category in ("Cc", "Cf", "Cs", "Co", "Cn", "Zl", "Zp"):
            kept.append(" ")
        else:
            kept.append(char)
    text = WHITESPACE_RE.sub(" ", "".join(kept)).strip()
    if len(text) > limit:
        text = text[: max(limit - 1, 0)].rstrip() + "…"
    return text


def discord_text(value: str, limit: int = TITLE_MAX_CHARS) -> str:
    """Make untrusted text inert in a Discord embed.

    Order matters: clean and cap first (so the cap cannot cut an escape in
    half), defang URL schemes so nothing auto-links, then escape every
    markdown character in a single pass. Mentions are also broken with a
    zero width space; allowed_mentions is the control that actually stops
    pings, this only keeps them from rendering as mentions.
    """
    text = clean_text(value, limit)
    text = URL_SCHEME_RE.sub(r"\1[:]//", text)
    text = MARKDOWN_CHARS_RE.sub(r"\\\1", text)
    return MENTION_RE.sub("@\u200b", text)


