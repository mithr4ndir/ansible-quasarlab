# State
# ---------------------------------------------------------------------------


def state_dir_default(env: Mapping[str, str] | None = None) -> Path:
    """LAB_CHANGELOG_STATE_DIR from the environment or the config file, else
    the XDG state directory. A relative override is ignored: it would resolve
    against whatever cwd the hook or timer happened to start in."""
    env = os.environ if env is None else env
    override = env.get("LAB_CHANGELOG_STATE_DIR")
    if override and os.path.isabs(override):
        return Path(override)
    if override:
        log.warning("LAB_CHANGELOG_STATE_DIR is not an absolute path; using the default")
    xdg = os.environ.get("XDG_STATE_HOME")
    base = Path(xdg) if xdg and os.path.isabs(xdg) else Path.home() / ".local" / "state"
    return base / "lab-changelog"


def load_state(state_dir: Path) -> dict[str, str]:
    path = state_dir / "posted.json"
    try:
        data = json.loads(path.read_text())
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as exc:
        # A corrupt state file would re-post everything in the window, which
        # is noisy but safe. Keep the evidence.
        log.warning("state file unreadable (%s); starting empty", type(exc).__name__)
        return {}
    posted = data.get("posted") if isinstance(data, dict) else None
    if not isinstance(posted, dict):
        return {}
    return {k: v for k, v in posted.items() if isinstance(k, str) and isinstance(v, str)}


def write_json_atomic(path: Path, data: Any) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.stem}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump(data, handle, indent=1, sort_keys=True)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def save_state(state_dir: Path, posted: dict[str, str], now: dt.datetime) -> None:
    horizon = now - STATE_KEEP
    kept = {k: v for k, v in posted.items() if (parse_ts(v) or now) >= horizon}
    write_json_atomic(state_dir / "posted.json", {"version": 1, "posted": kept})


def load_daily_end(state_dir: Path) -> dt.datetime | None:
    """End of the window of the last successful daily run, if any."""
    try:
        data = json.loads((state_dir / "daily.json").read_text())
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as exc:
        log.warning("daily state unreadable (%s); treating as a first run", type(exc).__name__)
        return None
    return parse_ts(data.get("last_success_end")) if isinstance(data, dict) else None


def save_daily_end(state_dir: Path, end: dt.datetime) -> None:
    write_json_atomic(state_dir / "daily.json", {"version": 1, "last_success_end": iso(end)})


def daily_window_start(last_end: dt.datetime | None, end: dt.datetime) -> dt.datetime:
    if last_end is None:
        return end - DAILY_FIRST_WINDOW
    if last_end > end:
        log.warning("daily: last successful run ends in the future (%s); looking back 24 hours", iso(last_end))
        return end - DAILY_FIRST_WINDOW
    start = last_end - DAILY_OVERLAP
    if end - start > DAILY_MAX_LOOKBACK:
        log.warning(
            "daily: last successful run ended %s; lookback capped to %d days, older items are not posted",
            iso(last_end), DAILY_MAX_LOOKBACK.days,
        )
        start = end - DAILY_MAX_LOOKBACK
    return start


class StateLock:
    def __init__(self, state_dir: Path, wait: float = LOCK_WAIT_SECS) -> None:
        self.path = state_dir / "lock"
        self.wait = wait
        self.fd: int | None = None

    def __enter__(self) -> "StateLock":
        self.path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        self.fd = os.open(self.path, os.O_RDWR | os.O_CREAT, 0o600)
        deadline = time.monotonic() + self.wait
        while True:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    os.close(self.fd)
                    self.fd = None
                    raise ChangelogError("another lab-changelog run holds the lock") from None
                time.sleep(0.5)

    def __exit__(self, *exc: object) -> None:
        if self.fd is not None:
            fcntl.flock(self.fd, fcntl.LOCK_UN)
            os.close(self.fd)
            self.fd = None


# ---------------------------------------------------------------------------
# Webhook secret, through the 1Password cache only
# ---------------------------------------------------------------------------

# Arguments are positional ($1..$4), never interpolated into the script text.
SECRET_SCRIPT = r"""
set -u
lib_dir=$1; slug=$2; ref=$3; token_file=$4
source "$lib_dir/op-killswitch.sh" || exit 3
source "$lib_dir/op-secret-cache.sh" || exit 3
if ! op_secret_cache_is_fresh "$OP_SECRET_CACHE_DIR/$slug"; then
    # A refresh would cost a 1Password read. Load the token FIRST: the quota
    # check (`op service-account ratelimit`) fails without one, and the systemd
    # unit exports only HOME and PATH. Reading the token file costs no call.
    if [[ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" && -r "$token_file" ]]; then
        OP_SERVICE_ACCOUNT_TOKEN=$(<"$token_file")
        export OP_SERVICE_ACCOUNT_TOKEN
    fi
    remaining=$(op_preflight_remaining)
    # Unlike the run-* wrappers this fails CLOSED on an unreadable quota: a
    # changelog is not worth a blind read. Without a token the cache can only
    # serve a stale value and never calls op.
    if [[ -z "$remaining" ]]; then
        logger -t lab-changelog "1P quota unreadable; not refreshing the webhook cache"
        unset OP_SERVICE_ACCOUNT_TOKEN
    elif (( remaining <= OP_PREFLIGHT_MIN_REMAINING )); then
        logger -t lab-changelog "1P quota at ${remaining}; not refreshing the webhook cache"
        unset OP_SERVICE_ACCOUNT_TOKEN
    fi
fi
cached_op_read "$slug" "$ref"
"""


def webhook_cache_slug(reference: str) -> str | None:
    """Cache slug for this reference, or None when no tag can be derived.

    Same scheme as terraform-quasarlab's tf-cached-secrets: the first 16 hex
    characters of sha256 over the exact reference string. The raw reference
    never appears in the slug, and each reference gets its own cache entry.
    """
    try:
        tag = hashlib.sha256(reference.encode("utf-8")).hexdigest()[:16]
    except (AttributeError, TypeError, ValueError):
        return None
    if not isinstance(tag, str) or not REFERENCE_TAG_RE.match(tag):
        return None
    return f"{WEBHOOK_CACHE_SLUG_PREFIX}.{tag}"


def resolve_webhook(lib_dir: str, reference: str, token_file: str) -> str | None:
    """Return the webhook URL, or None with the reason logged."""
    if not OP_REFERENCE_RE.match(reference):
        log.warning("webhook: configured 1Password reference is malformed; not posting")
        return None
    slug = webhook_cache_slug(reference)
    if slug is None:
        log.warning("webhook: could not derive a cache slug tag from the reference; not posting")
        return None
    for lib in ("op-killswitch.sh", "op-secret-cache.sh"):
        if not os.path.isfile(os.path.join(lib_dir, lib)):
            log.warning("webhook: %s missing from the op library directory; not posting", lib)
            return None
    env = dict(os.environ)
    env[CHILD_ENV] = "1"
    try:
        proc = subprocess.run(
            ["bash", "-c", SECRET_SCRIPT, "lab-changelog-secret", lib_dir, slug, reference, token_file],
            capture_output=True,
            text=True,
            timeout=SECRET_TIMEOUT_SECS,
            env=env,
            stdin=subprocess.DEVNULL,
            check=False,
        )
    except subprocess.TimeoutExpired:
        log.warning("webhook: cache lookup timed out; not posting")
        return None
    except OSError as exc:
        log.warning("webhook: cache lookup could not start (%s); not posting", type(exc).__name__)
        return None
    value = proc.stdout.strip()
    register_secret(value)
    if proc.returncode != 0 or not value:
        log.warning(
            "webhook: no value from the 1Password cache (rc=%s; kill switch active, rate limited or not cached); not posting",
            proc.returncode,
        )
        return None
    if not WEBHOOK_RE.match(value):
        log.warning("webhook: cached value is not a Discord webhook URL; not posting")
        return None
    return value


# ---------------------------------------------------------------------------
# Posting
# ---------------------------------------------------------------------------


class PostError(ChangelogError):
    pass


Opener = Callable[..., Any]
Sleeper = Callable[[float], None]


def retry_after_secs(error: urllib.error.HTTPError) -> float:
    try:
        body = json.loads(error.read() or b"{}")
        value = float(body.get("retry_after"))
    except (ValueError, TypeError, AttributeError, OSError):
        try:
            value = float(error.headers.get("Retry-After", "1"))
        except (ValueError, TypeError, AttributeError):
            value = 1.0
    return min(max(value, 0.0), POST_MAX_SLEEP_SECS)


def post_payload(webhook: str, payload: dict[str, Any], opener: Opener | None = None, sleep: Sleeper = time.sleep) -> None:
    """POST one message. Raises PostError whose text never holds the URL."""
    opener = opener or urllib.request.urlopen
    data = json.dumps(payload).encode("utf-8")
    delay = 1.0
    for attempt in range(1, POST_MAX_ATTEMPTS + 1):
        request = urllib.request.Request(
            webhook + "?wait=true",
            data=data,
            method="POST",
            headers={"Content-Type": "application/json", "User-Agent": USER_AGENT},
        )
        try:
            # WEBHOOK_RE already pinned the scheme to https.
            with opener(request, timeout=HTTP_TIMEOUT_SECS) as response:  # noqa: S310
                status = getattr(response, "status", 200)
                if 200 <= status < 300:
                    return
                failure = f"HTTP {status}"
                retryable = status >= 500
        except urllib.error.HTTPError as exc:
            status = exc.code
            failure = f"HTTP {status}"
            if status == 429:
                wait = retry_after_secs(exc)
                exc.close()
                if attempt == POST_MAX_ATTEMPTS:
                    break
                log.info("discord rate limited; retrying in %.1fs", wait)
                sleep(wait)
                continue
            exc.close()
            retryable = status >= 500
        except (urllib.error.URLError, OSError, ValueError) as exc:
            # These can carry the URL in their text. Keep only the type.
            failure = type(exc).__name__
            retryable = True
        if not retryable or attempt == POST_MAX_ATTEMPTS:
            raise PostError(f"discord post failed: {failure}") from None
        sleep(min(delay, POST_MAX_SLEEP_SECS))
        delay *= 2
    raise PostError("discord post failed: still rate limited after retries") from None


