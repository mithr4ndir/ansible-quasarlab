@dataclass
class HookInput:
    session_id: str
    transcript_path: str
    cwd: str
    reason: str


def parse_hook_input(raw: bytes | str) -> HookInput:
    if isinstance(raw, bytes):
        raw = raw.decode("utf-8", errors="replace")
    try:
        data = json.loads(raw)
    except ValueError:
        raise ChangelogError("hook input is not JSON") from None
    if not isinstance(data, dict):
        raise ChangelogError("hook input is not a JSON object")

    def field(name: str) -> str:
        value = data.get(name, "")
        return value if isinstance(value, str) else ""

    hook = HookInput(field("session_id"), field("transcript_path"), field("cwd"), field("reason"))
    if not hook.transcript_path:
        raise ChangelogError("hook input has no transcript_path")
    return hook


def read_stdin_limited(stream: Any = None) -> bytes:
    """Read hook JSON without ever hanging a session exit on an open stdin."""
    stream = stream if stream is not None else sys.stdin.buffer
    chunks: list[bytes] = []
    total = 0
    deadline = time.monotonic() + HOOK_STDIN_WAIT_SECS
    fd = stream.fileno()
    while total < HOOK_STDIN_MAX_BYTES:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        ready, _, _ = select.select([fd], [], [], remaining)
        if not ready:
            break
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        chunks.append(chunk)
        total += len(chunk)
    return b"".join(chunks)[:HOOK_STDIN_MAX_BYTES]


def transcript_start(path: str) -> dt.datetime:
    """Timestamp of the first transcript entry that has one.

    Only the `timestamp` key is looked at. Message content, which can hold
    secrets, is never kept, logged or passed on.
    """
    transcript = Path(path)
    try:
        with transcript.open("rb") as handle:
            read = 0
            for _ in range(TRANSCRIPT_SCAN_LINES):
                # Bounded readline: one enormous line cannot pull the whole
                # file into memory while a session is exiting.
                line = handle.readline(TRANSCRIPT_SCAN_BYTES - read)
                if not line:
                    break
                read += len(line)
                if read >= TRANSCRIPT_SCAN_BYTES:
                    break
                try:
                    entry = json.loads(line)
                except ValueError:
                    continue
                if isinstance(entry, dict):
                    stamp = parse_ts(entry.get("timestamp"))
                    if stamp is not None:
                        return stamp
    except OSError as exc:
        raise ChangelogError(f"cannot read transcript ({errno.errorcode.get(exc.errno or 0, 'error')})") from None
    raise ChangelogError("no timestamp in the first transcript entries")


def is_under(path: str, root: Path) -> bool:
    try:
        real = os.path.realpath(path)
        base = os.path.realpath(root)
        return os.path.commonpath([real, base]) == base
    except ValueError:
        return False


def herdr_worktrees_root() -> Path:
    return Path.home() / ".herdr" / "worktrees"


def session_skip_reason(hook: HookInput, start: dt.datetime, now: dt.datetime, min_secs: int) -> str | None:
    if hook.cwd and is_under(hook.cwd, herdr_worktrees_root()):
        return "session cwd is a herdr worktree (delegated agent session)"
    lasted = (now - start).total_seconds()
    if lasted < min_secs:
        return f"session lasted {int(lasted)}s, under the {min_secs}s minimum"
    return None


