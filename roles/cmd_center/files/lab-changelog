CONFIG_KEYS = frozenset({
    "LAB_CHANGELOG_REPOS",
    "LAB_CHANGELOG_OP_REFERENCE",
    "LAB_CHANGELOG_OP_LIB_DIR",
    "LAB_CHANGELOG_OP_TOKEN_FILE",
    "LAB_CHANGELOG_SESSION_MIN_SECS",
    "LAB_CHANGELOG_CLAUDE_BIN",
    "LAB_CHANGELOG_CLAUDE_MODEL",
    "LAB_CHANGELOG_CLAUDE_TIMEOUT",
    "LAB_CHANGELOG_HOST",
    "LAB_CHANGELOG_STATE_DIR",
})


def load_config_file(path: str) -> dict[str, str]:
    """KEY=VALUE lines. Only LAB_CHANGELOG_* settings are honoured, never PATH or the like."""
    values: dict[str, str] = {}
    if not path:
        return values
    try:
        text = Path(path).read_text()
    except FileNotFoundError:
        return values
    except OSError as exc:
        log.warning("config file unreadable (%s); using defaults", type(exc).__name__)
        return values
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        if key in CONFIG_KEYS:
            values[key] = value
    return values


def merged_env() -> dict[str, str]:
    # The SessionEnd hook runs with Claude's environment, not the timer's,
    # so the role's settings live in a config file both of them read.
    # A variable set in the environment wins over the file.
    return {**load_config_file(os.environ.get("LAB_CHANGELOG_CONFIG", DEFAULT_CONFIG_FILE)), **os.environ}


@dataclass
class Config:
    repos: list[str]
    reference: str
    lib_dir: str
    token_file: str
    session_min_secs: int
    state_dir: Path
    claude_bin: str
    claude_model: str
    claude_timeout: int
    host: str

    @classmethod
    def from_env(cls) -> "Config":
        env = merged_env()
        repos_raw = env.get("LAB_CHANGELOG_REPOS", "")
        repos = [r.strip() for r in repos_raw.split(",") if r.strip()] or list(DEFAULT_REPOS)
        valid = [r for r in repos if REPO_RE.match(r)]
        if len(valid) != len(repos):
            log.warning("ignoring %d malformed repo name(s)", len(repos) - len(valid))

        def int_env(name: str, default: int, low: int, high: int) -> int:
            try:
                return min(max(int(env.get(name, default)), low), high)
            except ValueError:
                return default

        host = clean_text(env.get("LAB_CHANGELOG_HOST", DEFAULT_HOST), 60) or DEFAULT_HOST
        return cls(
            repos=valid,
            reference=env.get("LAB_CHANGELOG_OP_REFERENCE", DEFAULT_OP_REFERENCE),
            lib_dir=env.get("LAB_CHANGELOG_OP_LIB_DIR", DEFAULT_OP_LIB_DIR),
            token_file=env.get(
                "LAB_CHANGELOG_OP_TOKEN_FILE", str(Path.home() / ".config" / "op" / "service-account-token")
            ),
            session_min_secs=int_env("LAB_CHANGELOG_SESSION_MIN_SECS", DEFAULT_SESSION_MIN_SECS, 0, 86400),
            state_dir=state_dir_default(env),
            claude_bin=env.get("LAB_CHANGELOG_CLAUDE_BIN", "claude"),
            claude_model=env.get("LAB_CHANGELOG_CLAUDE_MODEL", "haiku"),
            claude_timeout=int_env("LAB_CHANGELOG_CLAUDE_TIMEOUT", 90, 5, 600),
            host=host,
        )


@dataclass
class RunResult:
    sent: int
    # True only when every gh query succeeded and every new item was posted
    # (or there was nothing new). Only then may the daily boundary advance.
    complete: bool


def run_changelog(
    cfg: Config,
    start: dt.datetime,
    end: dt.datetime,
    dry_run: bool,
    use_llm: bool,
    runner: Runner | None = None,
    opener: Opener | None = None,
    sleep: Sleeper = time.sleep,
    out: Any = None,
) -> int:
    """Collect, dedup, build and post (or print). Returns the number of posts."""
    if dry_run:
        return _run_locked(cfg, start, end, True, use_llm, runner, opener, sleep, out).sent
    with StateLock(cfg.state_dir):
        return _run_locked(cfg, start, end, False, use_llm, runner, opener, sleep, out).sent


def run_daily(
    cfg: Config,
    end: dt.datetime,
    since: dt.datetime | None,
    dry_run: bool,
    use_llm: bool,
    runner: Runner | None = None,
    opener: Opener | None = None,
    sleep: Sleeper = time.sleep,
    out: Any = None,
) -> int:
    """The daily run: window from the last successful daily run to `end`.

    The boundary is read and written under the state lock, and only advanced
    after a complete run. A --since window only advances it when it reaches
    at least as far back as the boundary would have, so a narrow manual run
    cannot skip the stretch in between.
    """
    if dry_run:
        start = since or daily_window_start(load_daily_end(cfg.state_dir), end)
        return _run_locked(cfg, start, end, True, use_llm, runner, opener, sleep, out).sent
    with StateLock(cfg.state_dir):
        default_start = daily_window_start(load_daily_end(cfg.state_dir), end)
        start = since or default_start
        result = _run_locked(cfg, start, end, False, use_llm, runner, opener, sleep, out)
        if result.complete and start <= default_start:
            save_daily_end(cfg.state_dir, end)
        elif not result.complete:
            log.warning("daily: run incomplete; the next daily window still starts from the last successful run")
        return result.sent


def _run_locked(cfg: Config, start: dt.datetime, end: dt.datetime, dry_run: bool, use_llm: bool,
                runner: Runner | None, opener: Opener | None, sleep: Sleeper, out: Any) -> RunResult:
    posted = load_state(cfg.state_dir)
    failed: list[str] = []
    items = collect(cfg.repos, start, end, runner, failed)
    fresh = [item for item in items if item.key not in posted]
    log.info("window %s to %s: %d items, %d new", iso(start), iso(end), len(items), len(fresh))
    if not fresh:
        if dry_run:
            print(json.dumps({"payloads": [], "note": "nothing new"}, indent=2), file=out or sys.stdout)
        return RunResult(0, not failed)

    highlights = None
    if use_llm:
        highlights = generated_highlights(fresh, cfg.claude_bin, cfg.claude_model, cfg.claude_timeout,
                                          cfg.state_dir if cfg.state_dir.is_dir() else Path("/"))
    generated = highlights is not None
    messages = build_messages(fresh, start, end, cfg.host, highlights or deterministic_highlights(fresh), generated)

    if dry_run:
        payloads = [payload for payload, _ in messages]
        print(json.dumps({"payloads": payloads}, indent=2, ensure_ascii=False), file=out or sys.stdout)
        return RunResult(0, False)

    webhook = resolve_webhook(cfg.lib_dir, cfg.reference, cfg.token_file)
    if webhook is None:
        return RunResult(0, False)
    sent = 0
    for payload, keys in messages:
        post_payload(webhook, payload, opener=opener, sleep=sleep)
        stamp = iso(utcnow())
        for key in keys:
            posted[key] = stamp
        sent += 1
        # Persist before the next post: a SIGTERM from TimeoutStartSec or a
        # crash skips `finally`, and unsaved keys would be posted again.
        save_state(cfg.state_dir, posted, utcnow())
    log.info("posted %d message(s)", sent)
    return RunResult(sent, not failed)


def session_end_work(cfg: Config, start: dt.datetime, use_llm: bool) -> None:
    now = utcnow()
    start = max(start, now - MAX_WINDOW)
    run_changelog(cfg, start, now, dry_run=False, use_llm=use_llm)


def detach(work: Callable[[], None]) -> None:
    """Run work in a grandchild outside the session's process group.

    The caller returns straight away. The grandchild has its own session
    (setsid), is reparented to init, and has stdin, stdout and stderr on
    /dev/null, so it holds none of the hook's pipes open.
    """
    pid = os.fork()
    if pid > 0:
        os.waitpid(pid, 0)
        return
    try:
        os.setsid()
        if os.fork() > 0:
            os._exit(0)
        devnull = os.open(os.devnull, os.O_RDWR)
        for fd in (0, 1, 2):
            os.dup2(devnull, fd)
        try:
            work()
        except BaseException:  # noqa: BLE001  the log is the only place left to report to
            log.exception("session-end worker failed")
    finally:
        os._exit(0)


def cmd_session_end(args: argparse.Namespace, cfg: Config) -> int:
    if os.environ.get(CHILD_ENV):
        return 0
    hook = parse_hook_input(read_stdin_limited())
    start = transcript_start(hook.transcript_path)
    now = utcnow()
    reason = session_skip_reason(hook, start, now, cfg.session_min_secs)
    if reason:
        log.info("session-end: skipped: %s", reason)
        return 0
    if args.dry_run:
        run_changelog(cfg, max(start, now - MAX_WINDOW), now, dry_run=True, use_llm=not args.no_llm)
        return 0
    detach(lambda: session_end_work(cfg, start, not args.no_llm))
    return 0


def cmd_daily(args: argparse.Namespace, cfg: Config) -> int:
    end = utcnow()
    since = None
    if args.since:
        since = parse_ts(args.since)
        if since is None or since >= end:
            raise ChangelogError("--since must be an ISO 8601 time in the past")
        since = max(since, end - MAX_WINDOW)
    run_daily(cfg, end, since, dry_run=args.dry_run, use_llm=not args.no_llm)
    return 0


class QuietParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:  # type: ignore[override]
        raise ChangelogError(f"usage: {message}")


def build_parser() -> argparse.ArgumentParser:
    parser = QuietParser(prog="lab-changelog", add_help=True)
    sub = parser.add_subparsers(dest="command", required=True)
    for name in ("daily", "session-end"):
        cmd = sub.add_parser(name)
        cmd.add_argument("--dry-run", action="store_true", help="print the payload, post nothing")
        cmd.add_argument("--no-llm", action="store_true", help="skip generated highlights")
        if name == "daily":
            cmd.add_argument("--since", help="window start (ISO 8601) instead of 24 hours ago")
    return parser


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    session_end = bool(argv) and argv[0] == "session-end"
    dry_run = "--dry-run" in argv
    if session_end and not dry_run:
        # SessionEnd hook contract: never write to stdout, always exit 0.
        try:
            devnull = os.open(os.devnull, os.O_WRONLY)
            os.dup2(devnull, 1)
            os.close(devnull)
            sys.stdout = open(os.devnull, "w")
        except OSError:
            pass
    try:
        cfg_state = state_dir_default(merged_env())
        setup_logging(cfg_state, to_stderr=not session_end)
        args = build_parser().parse_args(argv)
        cfg = Config.from_env()
        if args.command == "session-end":
            return cmd_session_end(args, cfg)
        return cmd_daily(args, cfg)
    except SystemExit as exc:
        if session_end:
            return 0
        return exc.code if isinstance(exc.code, int) else 1
    except ChangelogError as exc:
        log.warning("%s", exc)
        return 0 if session_end else 1
    except BaseException:  # noqa: BLE001  session-end must never fail the hook
        log.exception("unexpected failure")
        return 0 if session_end else 1


if __name__ == "__main__":
    sys.exit(main())
